# Copy to .env.local for development. Real values live only in Vercel's
# encrypted env vars for production — never commit .env.local. (plan §15)

# MySQL on cPanel/Exonhost — dedicated DB + dedicated low-privilege user, TLS required.
# mysql://user:password@host:3306/nova_assets
DATABASE_URL=
# "true" (default, opportunistic TLS), "strict" (verify CA), or "false" (no TLS — dev only)
DATABASE_SSL=true

# AES-256-GCM keys — generate with: openssl rand -base64 32 (one for each, do not reuse)
FIELD_ENCRYPTION_KEY=
FILE_ENCRYPTION_KEY=

# Brevo transactional email — leave unset in dev to log OTP codes to the console instead of sending.
BREVO_API_KEY=
MAIL_FROM=no-reply@novasstrading.com
MAIL_FROM_NAME=Nova SS Asset Manager

# Login UI auto-suffixes this domain onto the typed local-part.
NEXT_PUBLIC_EMAIL_DOMAIN=novasstrading.com
# Used in email templates (logo URL, sign-in link).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# cPanel/Exonhost FTP or SFTP account, scoped to a folder outside public_html (plan §3).
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_SECURE=true
FTP_BASE_PATH=/nova_secure_files
